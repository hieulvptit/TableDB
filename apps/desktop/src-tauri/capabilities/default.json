{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the main window. No shell, fs, http or opener permissions are granted to the WebView.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-sidecar-request",
    "allow-sidecar-cancel",
    "allow-secret-set",
    "allow-secret-get",
    "allow-secret-delete",
    "allow-agent-config",
    "allow-agent-http",
    "allow-agent-http-cancel",
    "allow-oidc-begin",
    "allow-genai-login-begin",
    "allow-genai-proxy-check",
    "allow-genai-login-cancel",
    "allow-genai-login-forget",
    "allow-open-external",
    "allow-app-info",
    "allow-driver-import",
    "allow-driver-list",
    "allow-driver-remove",
    "allow-ssh-key-import",
    "allow-ssh-key-list",
    "allow-ssh-key-remove",
    "allow-workspace-load",
    "allow-workspace-save",
    "allow-workspace-clear",
    "allow-transfer-save-begin",
    "allow-transfer-save-chunk",
    "allow-transfer-save-finish",
    "allow-transfer-save-abort",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
